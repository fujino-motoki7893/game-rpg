{
  "name": "tiny-turn-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:characters": "node scripts/generate-character-sheets.mjs",
