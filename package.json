  },
  "dependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.15",
    "wrangler": "^4.95.0"
  }
}
