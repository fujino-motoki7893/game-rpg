{
  "name": "tiny-turn-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:characters": "node scripts/generate-character-sheets.mjs",
    "assets:humanoids": "node scripts/generate-humanoid-sprites.mjs",
    "assets:monsters": "node scripts/generate-monster-sprites.mjs",
    "assets:monsters:external": "node scripts/generate-monster-sprites-external.mjs",
    "assets:tiles": "node scripts/generate-terrain-tiles.mjs",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "phaser": "^4.1.0",
    "rot-js": "^2.2.1"
  },
  "devDependencies": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.15",
    "vitest": "^4.1.10",
    "wrangler": "^4.95.0"
  }
}
